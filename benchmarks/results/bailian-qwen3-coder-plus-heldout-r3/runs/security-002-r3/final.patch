+import re
+
 def redact(value):
-    return value
+    if isinstance(value, str):
+        # Redact authorization, token, password, and api_key values
+        patterns = [
+            r'(?i)(authorization\s*[:=]\s*)[^\s,;]+',
+            r'(?i)(token\s*[:=]\s*)[^\s,;]+',
+            r'(?i)(password\s*[:=]\s*)[^\s,;]+',
+            r'(?i)(api_key\s*[:=]\s*)[^\s,;]+'

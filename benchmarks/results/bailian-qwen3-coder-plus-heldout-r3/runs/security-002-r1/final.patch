+import re
+
 def redact(value):
+    if isinstance(value, str):
+        # Redact authorization, token, password, and api_key values
+        patterns = [
+            r'(?i)(authorization\s*[:=]\s*["\']?)[^\s"\']+(["\']?)',
+            r'(?i)(token\s*[:=]\s*["\']?)[^\s"\']+(["\']?)',
+            r'(?i)(password\s*[:=]\s*["\']?)[^\s"\']+(["\']?)',
+            r'(?i)(api_key\s*[:=]\s*["\']?)[^\s"\']+(["\']?)',
+        ]
+        result = value
+        for pattern in patterns:
+            result = re.sub(pattern, r'\g<1>***REDACTED***\g<2>', result)
+        return result
     return value
